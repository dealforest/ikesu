{
  "name": "ikesu-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "vars": {
    // bridge がいない部屋のアプリ接続を切るまでの時間（ミリ秒）。
    "APP_WAIT_MS": "30000"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
